# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgresql://tugma:tugma@localhost:5432/tugma?schema=public

# --- HTTP ----------------------------------------------------------------------
PORT=8001
FRONTEND_URL=http://localhost:3000
# Auth cookies are Secure + SameSite=None by default. Browsers treat
# http://localhost as secure, so this works for local dev too.
COOKIE_SECURE=true

# --- Auth ----------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@tugmademo.ph
ADMIN_PASSWORD=change-me
DEMO_USER_PASSWORD=change-me

# --- Password-reset email (optional; without it the link is logged locally) --
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM_NAME=TUGMA

