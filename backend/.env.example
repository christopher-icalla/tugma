# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgresql://tugma:tugma@localhost:5432/tugma?schema=public

# --- HTTP ----------------------------------------------------------------------
PORT=8001
# Comma-separated list of web app origins allowed to call the API with cookies.
FRONTEND_URL=http://localhost:3000
# Auth cookies are httpOnly + Secure. Browsers treat http://localhost as secure.
COOKIE_SECURE=true
# lax: web app and API on the same site (tugmaapp.com + api.tugmaapp.com). Blocks CSRF.
# none: only if they are on different sites (then the Origin check is the CSRF guard).
COOKIE_SAMESITE=lax
# Reverse proxies in front of the API (0 = none). Set to 1 behind a load balancer/PaaS
# router so rate limits and login lockout see the real client IP. Leave 0 otherwise,
# or clients can spoof their IP with X-Forwarded-For.
TRUST_PROXY=0

# --- Auth ----------------------------------------------------------------------
# The API refuses to start with these placeholders, short values, or previously leaked passwords.
# JWT_SECRET (32+ chars): node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@tugmademo.ph
# 12+ characters each. Quote values that contain '#' or spaces, e.g. "Pa#ss word".
ADMIN_PASSWORD=change-me
DEMO_USER_PASSWORD=change-me

# --- Password-reset email (optional; without it the link is logged locally) --
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM_NAME=TUGMA

# Daily control run at this Manila time (HH:MM, 24-hour), or "off". One API
# instance should run the schedule; set "off" on any extra instances.
CONTROL_SCHEDULE=02:00
# Email follow-up reminders after each scheduled run (true/false).
SCHEDULE_REMINDERS=false

# --- Stellar / Soroban ---------------------------------------------------------
STELLAR_NETWORK=TESTNET
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_CONTRACT_ID=CC734HZAIWGKKFFD5CZNY73EC3YJJZYDK6IJQQLCZUOSD34U3SY33ZTH
STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet

# --- Two-party (multisig) attestation, Testnet only. Off unless all three are set --
# The attestation account needs both TUGMA's key and the reviewer's key to sign.
# Create it with: node scripts/create-attestation-account.js --tugma-signer G... --reviewer G...
# then authorize it on the contract (add_signer). See docs/two-party-attestation.md.
MULTISIG_ATTESTATION_ACCOUNT=
# TUGMA's server signing key (S...). A secret: set it in your host's secret store,
# never in a committed file. On its own it cannot sign for the attestation account.
MULTISIG_TUGMA_SIGNER_SECRET=
# The independent reviewer's PUBLIC key (G...). Their secret key stays in their wallet.
MULTISIG_REVIEWER_PUBLIC_KEY=
# How long the reviewer has to sign a prepared attestation, in hours.
MULTISIG_COSIGN_TTL_HOURS=24
