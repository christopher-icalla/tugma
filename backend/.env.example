# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgresql://tugma:tugma@localhost:5432/tugma?schema=public

# --- HTTP ----------------------------------------------------------------------
PORT=8001
# Comma-separated list of web app origins allowed to call the API with cookies.
FRONTEND_URL=http://localhost:3000
# Auth cookies are httpOnly + Secure. Browsers treat http://localhost as secure.
COOKIE_SECURE=true
# lax: web app and API on the same site (tugmaapp.com + api.tugmaapp.com). Blocks CSRF.
# none: only if they are on different sites (then the Origin check is the CSRF guard).
COOKIE_SAMESITE=lax
# Reverse proxies in front of the API (0 = none). Set to 1 behind a load balancer/PaaS
# router so rate limits and login lockout see the real client IP. Leave 0 otherwise,
# or clients can spoof their IP with X-Forwarded-For.
TRUST_PROXY=0

# --- Auth ----------------------------------------------------------------------
# The API refuses to start with these placeholders, short values, or previously leaked passwords.
# JWT_SECRET (32+ chars): node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@tugmademo.ph
# 12+ characters each. Quote values that contain '#' or spaces, e.g. "Pa#ss word".
ADMIN_PASSWORD=change-me
DEMO_USER_PASSWORD=change-me

# --- Password-reset email (optional; without it the link is logged locally) --
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM_NAME=TUGMA

# --- Stellar / Soroban ---------------------------------------------------------
STELLAR_NETWORK=TESTNET
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_CONTRACT_ID=CC734HZAIWGKKFFD5CZNY73EC3YJJZYDK6IJQQLCZUOSD34U3SY33ZTH
STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet
