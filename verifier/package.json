{
  "name": "@tugma/verify",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone verifier for TUGMA evidence packages: recomputes the canonical SHA-256 and checks it against the Stellar Testnet attestation contract through Soroban RPC, without TUGMA's API.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "node --test",
    "verify": "node bin/tugma-verify.js",
    "web": "node bin/serve-web.js",
    "demo": "node demo/run-demo.js"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.2.0"
  },
  "bin": {
    "tugma-verify": "./bin/tugma-verify.js"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
